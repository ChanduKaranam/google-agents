# MSBuddy configuration. Copy to .env and fill in.
#
# Option A — Vertex AI (recommended for grounded search):
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# `global` serves the widest model set; grounding works there.
GOOGLE_CLOUD_LOCATION=global

# Option B — Gemini API key (comment out the three lines above):
# GEMINI_API_KEY=your-api-key-here

# Models. Both default to gemini-2.5-flash if unset — chosen because search
# grounding metadata is reliably returned there (measured; some newer models
# return zero grounding chunks for long-instruction agents).
# MSBUDDY_MODEL=gemini-2.5-flash
# MSBUDDY_SEARCH_MODEL=gemini-2.5-flash
