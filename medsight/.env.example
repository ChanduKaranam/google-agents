GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# 'global' uses Vertex dynamic shared quota — far fewer 429 RESOURCE_EXHAUSTED
# errors than a fixed region. Recommended for Gemini 2.5 generateContent.
GOOGLE_CLOUD_LOCATION=global
# Set to the Cloud Run service URL after the first deploy so the A2A agent card
# advertises the correct public address (see README / Dockerfile).
# A2A_PUBLIC_URL=https://medsight-a2ui-xxxxxxxx-uc.a.run.app
