# Copy to `.env`. `adk run` / `adk web` load it automatically; on Agent Engine
# set these as deployment environment variables instead.

GOOGLE_GENAI_USE_ENTERPRISE=1
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Model for the orchestrator and both specialists.
LODESTAR_MODEL=gemini-2.5-flash

# Ask a human before the first call of a batch goes out. Set to 0 for an
# unattended run — read the comment in config.py first.
LODESTAR_CONFIRM_BEFORE_CALLS=1

# Total dial attempts per lead, first attempt included. Past this a lead is
# flagged for a human instead of retried forever.
LODESTAR_MAX_CALL_ATTEMPTS=3

# Leads sent to the analysis specialist per call.
LODESTAR_ANALYSIS_CHUNK_SIZE=25

# --- Hello.ai --------------------------------------------------------------
# Leave these empty and no call is ever placed: trigger_hello_ai_call refuses
# and reports every lead unattempted, with the reason. It never simulates a
# call. Fill them in only when you mean to dial real people.
HELLO_AI_BASE_URL=
HELLO_AI_API_KEY=

# The voice bot placing the calls, if the account has more than one.
HELLO_AI_AGENT_ID=
HELLO_AI_TIMEOUT=30

# --- underwriting thresholds ------------------------------------------------
# The lines the recommendation rules turn on, from
# singapore_policy_guidelines.md. Defaults shown; set one only to move it.
LODESTAR_LOW_EXISTING_COVER_SGD=50000
LODESTAR_TERM_LIFE_MAX_INCOME_SGD=60000
LODESTAR_TERM_LIFE_MAX_AGE=45
LODESTAR_ILP_MAX_AGE=35
LODESTAR_ILP_MIN_INCOME_SGD=80000
LODESTAR_CARESHIELD_MIN_AGE=40
LODESTAR_CARESHIELD_MIN_INCOME_SGD=50000
