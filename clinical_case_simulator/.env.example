# --- Choose ONE backend ---

# Option A: Gemini API (fastest for local dev)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-aistudio-api-key

# Option B: Vertex AI (required for Cloud Run / Gemini Enterprise deployment)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Simulator config ---
CS_MODEL=gemini-2.5-flash
CS_EVAL_MODEL=gemini-2.5-pro
CS_PRACTICE_MODE=TRUE
